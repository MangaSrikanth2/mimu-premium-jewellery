# Copy this file to .env and fill in values locally.
# Never commit real credentials.

# SQLite example (local):
# DATABASE_URL="file:./dev.db"
DATABASE_URL=

# Payment (optional — used when Razorpay is wired up)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Auth (optional — for production auth)
JWT_SECRET=
